# Copy to .env (gitignored). Never commit real keys.
# Live LLM mode: set both. Without them the offline rule-based engine runs.
LLM_MODEL=groq/openai/gpt-oss-120b
GROQ_API_KEY=
# Force an engine: offline | live (default: live when a key exists)
SRE_ENGINE=
# Clerk (cloud / signed-in mode). Leave empty for local demo mode.
CLERK_JWKS_URL=
CLERK_ISSUER=
CORS_ORIGINS=http://localhost:3000
# Cloud only (set by Terraform): JOBS_TABLE, SQS_QUEUE_URL, DEFAULT_AWS_REGION
